<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ServiceStack.EventStore</RootNamespace>
    <AssemblyName>ServiceStack.EventStore</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <Version>0.1.0</Version>
    <PackageId>ServiceStack.EventStore</PackageId>
    <Title>ServiceStack.EventStore</Title>
    <Authors>wwwlicious</Authors>
    <Description>ServiceStack plugin for event-sourced systems using EventStore.</Description>
    <PackageLicenseExpression>MPL-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/DavidBrower/servicestack-eventstore</PackageProjectUrl>
    <RepositoryUrl>https://github.com/DavidBrower/servicestack-eventstore</RepositoryUrl>
    <PackageTags>ServiceStack;EventStore</PackageTags>
    <PackageReadmeFile>ReadMe.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="EventStore.Client" Version="22.0.0" />
    <PackageReference Include="Polly" Version="8.8.0" />
    <PackageReference Include="ServiceStack.Server" Version="10.4.2" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../ReadMe.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
